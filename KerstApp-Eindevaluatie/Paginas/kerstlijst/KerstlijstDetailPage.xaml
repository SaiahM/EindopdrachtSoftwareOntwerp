<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KerstApp_Eindevaluatie.Paginas.kerstlijst.KerstlijstDetailPage"
             Title="Kerst lijst Detail ">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding Foutmelding}" TextColor="Red" />

            <Entry Placeholder="Titel"
                   Text="{Binding Item.Titel}" />

            <Entry Placeholder="Prijs (leeg mag)"
                   Keyboard="Numeric"
                   Text="{Binding PrijsInput}" />

            <Editor Placeholder="Omschrijving"
                    AutoSize="TextChanges"
                    HeightRequest="120"
                    Text="{Binding Item.Omschrijving}" />

            <HorizontalStackLayout Spacing="12">
                <Image WidthRequest="70"
                       HeightRequest="70"
                       Aspect="AspectFill"
                       Source="{Binding Item.BeeldUrl}" />
                <Entry Placeholder="Beeld URL"
                       HorizontalOptions="FillAndExpand"
                       Text="{Binding Item.BeeldUrl}" />
            </HorizontalStackLayout>

            <Picker Title="Geschenk voor (mag leeg)"
                    ItemsSource="{Binding Personen}"
                    ItemDisplayBinding="{Binding Voornaam}"
                    SelectedItem="{Binding SelectedPersoon}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Bewaren" Command="{Binding SaveCommand}" />
                <Button Text="Annuleren" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>